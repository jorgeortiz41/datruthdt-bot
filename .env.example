# ---- Required ----------------------------------------------------------------

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Discord bot token — https://discord.com/developers/applications
# (Your app -> Bot -> Reset Token). Never commit the real value.
DISCORD_BOT_TOKEN=

# ---- Optional ----------------------------------------------------------------

# Which persona config in personas/ to load.
CREATORBOT_PERSONA=datruthdt

# Restrict slash-command registration to one guild for instant updates while
# developing. Leave blank to register globally (can take up to an hour).
DISCORD_DEV_GUILD_ID=

# Semantic retrieval. Without this the bot uses built-in lexical (BM25) search,
# which works fine — this just improves recall on paraphrased questions.
# https://dash.voyageai.com/
VOYAGE_API_KEY=

# Contact address advertised in the User-Agent of any outbound scrape request.
# Required if you enable a fetching source in the persona config.
CREATORBOT_CONTACT_EMAIL=

# Model + effort overrides (see personas/*.yaml for defaults)
# CREATORBOT_MODEL=claude-opus-5
# CREATORBOT_EFFORT=medium

# ---- YouTube access ----------------------------------------------------------
# YouTube IP-blocks unauthenticated transcript requests from many networks
# (you'll see "IpBlocked" / "Sign in to confirm you're not a bot" during ingest).
# Use ONE of these to ingest as yourself. See docs/TROUBLESHOOTING.md.

# Read cookies from your own logged-in browser: chrome | firefox | safari | edge | brave
# YOUTUBE_COOKIES_FROM_BROWSER=chrome

# ...or a Netscape-format cookies.txt exported from your browser
# YOUTUBE_COOKIES_FILE=/path/to/cookies.txt

# ...or route through a proxy
# YOUTUBE_PROXY=http://user:pass@host:port
# WEBSHARE_PROXY_USERNAME=
# WEBSHARE_PROXY_PASSWORD=
